<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- Indicate that camera is optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" /> <!-- Indicate that telephony (SMS) is optional -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ApplicationClass"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tournote"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".Onboarding.Activity.ForgotPassword"
            android:exported="false" />
        <activity
            android:name=".Onboarding.Activity.NoInternetActivity"
            android:exported="false" />

        <service
            android:name=".Functionality.Segments.TrackFriends.Services.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".Profile.UpdateProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.AutoExpenseDetection.SmsGroupSelectionActivity"
            android:exported="true"
            android:launchMode="singleTop" /> <!-- Onboarding & Launch -->
        <activity
            android:name=".Onboarding.Activity.CustomSplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Onboarding.Activity.GettingStartedActivity"
            android:exported="false" />
        <activity
            android:name=".Onboarding.Activity.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".Onboarding.Activity.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".Onboarding.Activity.LogInActivity"
            android:exported="false" /> <!-- Main Activity -->
        <activity
            android:name=".Functionality.Activity.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" /> <!-- Expense Module -->
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseAddActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseInfoActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseNoteActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseSplitterActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseSettleUpActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Expenses.Activity.ExpenseRecordPaymentActivity"
            android:exported="false" /> <!-- Memories Module -->
        <activity
            android:name=".Functionality.Segments.Memories.activity.ImageActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Memories.activity.ImageFullActivity"
            android:exported="false" />
        <activity
            android:name=".Functionality.Segments.Memories.activity.ReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity> <!-- Group Module -->
        <activity
            android:name=".Groups.Activity.GroupSelectorActivity"
            android:exported="false" />
        <activity
            android:name=".Groups.Activity.activityGroupInfo"
            android:exported="false" />
        <activity
            android:name=".Groups.Activity.activityProfileInfo"
            android:exported="false" /> <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".Functionality.Segments.Expenses.AutoExpenseDetection.Debit.SmsDebitReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".Functionality.Segments.Expenses.AutoExpenseDetection.Credit.SmsCreditReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".Functionality.Segments.Expenses.AutoExpenseDetection.Debit.ReplyReceiver"
            android:exported="true" />
    </application>

</manifest>