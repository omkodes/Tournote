<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_theme_Light"
    android:fillViewport="true"
    tools:context=".Functionality.Segments.Expenses.Fragment.ExpensesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:background="@color/green_theme_Light_taskbar"
            app:layout_constraintTop_toTopOf="parent"
            android:gravity="center_vertical"
            android:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:id="@+id/grp_logo"
                android:layout_height="40dp"
                android:scaleType="fitXY"
                android:padding="6dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/defaultgroupimage"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="4dp" />

            <TextView
                android:layout_width="0dp"
                android:id="@+id/grp_name"
                android:layout_gravity="center_vertical"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/more_options"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/baseline_more_vert_24"
                android:visibility="gone"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="5dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <!--final expense output-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="20dp">

                <TextView
                    android:id="@+id/txtMyFinalResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="You are owed ₹4000.00 overall"
                    android:textColor="@color/textGreen"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!--<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You owe ₹4000.00 overall"
                    android:textColor="@color/textRed"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    />-->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recvwFinalDistributionRelaventtoMe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_expensefragment_finalresult_borrowed" />

                <TextView
                    android:id="@+id/txtTotalGroupExpenditure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="Total group expenditure ₹4000.00"
                    android:textColor="@color/bluetext"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/btnAddExpense"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/greenbutton">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="30dp"
                        android:text="Add Expense"
                        android:textColor="@color/black"
                        android:layout_centerInParent="true"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/btnSettleUp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/greenbutton">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="30dp"
                        android:text="Settle Up"
                        android:textColor="@color/black"
                        android:layout_centerInParent="true"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </RelativeLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_expense" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>