<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Functionality.Segments.Expenses.Activity.ExpenseInfoActivity"
    android:background="@color/green_theme_Light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:background="@color/green_theme_Light_taskbar"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="30dp"
            android:id="@+id/btnCloseActivity"
            android:layout_height="30dp"
            android:scaleType="fitXY"
            android:padding="6dp"
            android:src="@drawable/cross"
            android:layout_gravity="center_vertical"
            android:layout_marginVertical="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Details"
            android:gravity="left"
            android:layout_marginLeft="20dp"
            app:layout_constraintStart_toEndOf="@id/btnCloseActivity"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteRecord"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:textColor="#E0E0E0"
            android:textSize="22sp" />

        <ImageView
            android:layout_width="wrap_content"
            android:id="@+id/btnDeleteRecord"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:src="@drawable/bin"
            android:layout_gravity="center_vertical"
            android:layout_marginVertical="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginRight="10dp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!--<ImageView
            android:layout_width="wrap_content"
            android:id="@+id/btnEdit"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:src="@drawable/pencil"
            android:layout_gravity="center_vertical"
            android:layout_marginVertical="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
-->
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:paddingBottom="60dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/btnRepresentation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:clickable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:focusable="true"
                    android:background="@drawable/greenbutton">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/defaultgroupimage"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toEndOf="@id/btnRepresentation"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColorHint="@color/white"
                    android:hint="Enter a description"
                    android:textSize="18sp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <RelativeLayout
                    android:id="@+id/btnCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/whitebutton">
                    <TextView
                        android:id="@+id/txtCurrency"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="₹"
                        android:textColor="@color/black"
                        android:textSize="30sp"
                        android:textAlignment="center"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/txtAmount"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="10dp"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toEndOf="@id/btnCurrency"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:hint="0.00"
                    android:textSize="35sp"
                    android:inputType="number" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Added by you on 17 July 2025"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/imgPayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="200dp"
                        app:cardBackgroundColor="@color/green_theme_Light"
                        android:layout_gravity="top"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/avatar_select_circle">
                        <ImageView
                            android:id="@+id/imgPaidBy"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:src="@drawable/imageselector"
                            android:scaleType="fitXY" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txtPaidBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You paid ₹ 20"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="20dp"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSplitMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_split_member"
                android:layout_marginTop="-5dp"
                android:visibility="gone"/>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillPreview"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                tools:visibility="visible"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgBillPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebView"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:visibility="visible"
                tools:visibility="visible">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtLabelNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="gone"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/txtNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                android:visibility="gone"
                android:textColor="@color/white"
                android:textSize="14sp"
                />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>