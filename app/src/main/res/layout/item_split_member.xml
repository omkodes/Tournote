<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"> <View
    android:id="@+id/verticalLineTop"
    android:layout_width="2dp"
    android:layout_height="0dp" android:layout_marginStart="28dp"
    android:background="@color/white"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@id/horizontalLine"
    app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/verticalLineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp" android:layout_marginStart="28dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/horizontalLine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/horizontalLine"
        android:layout_width="20dp"
        android:layout_height="2dp"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="@id/verticalLineTop"
        app:layout_constraintTop_toTopOf="@id/cardProfilePic"
        app:layout_constraintBottom_toBottomOf="@id/cardProfilePic" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfilePic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:cardCornerRadius="25dp"
        app:cardBackgroundColor="@color/green_theme_Light"
        app:layout_constraintStart_toEndOf="@id/horizontalLine"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgProfilePic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/imageselector" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/txtShareAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="You owe ₹ 0.00"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/cardProfilePic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>